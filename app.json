{
  "expo": {
    "name": "pricego",
    "slug": "pricego",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pricego",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "PriceGo가 가격을 인식하려면 마이크 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.nexdataforge.pricego",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PriceGo가 가격을 인식하려면 마이크 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PriceGo가 가격표 사진을 읽으려면 사진 권한이 필요합니다.",
          "cameraPermission": "PriceGo가 가격표를 촬영하려면 카메라 권한이 필요합니다.",
          "microphonePermission": "PriceGo가 음성 인식을 사용하려면 마이크 권한이 필요합니다."
        }
      ],
      [
        "expo-ocr-kit",
        {
          "cameraPermission": "PriceGo가 가격표를 촬영하려면 카메라 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac5c7d85-49d0-47ab-a753-84840321de0d"
      }
    }
  }
}
